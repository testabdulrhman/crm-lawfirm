<?xml version="1.0" encoding="UTF-8"?>
<!-- شاشة عرض المكتب — تطبيق ويب لتلفزيون سامسونج (Tizen). يُثبَّت بوضع المطوّر، لا عبر المتجر. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://app.redwan.sa/officeboard" version="1.0.0" viewmodes="maximized">
    <tizen:application id="RdwnBoard1.OfficeBoard" package="RdwnBoard1" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>شاشة المكتب</name>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <!-- Tizen 9 يفرض افتراضياً script-src/style-src 'self' فيُحجب كل ما هو داخل الصفحة (شاشة سوداء — 2026-10-13).
         الصفحة ملف واحد بأسلوبها وشيفرتها، ومعها خطوط Google وبث الكاميرا (go2rtc) وSupabase وOpen-Meteo. -->
    <tizen:content-security-policy>default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://zwaahunavepleczuamuy.supabase.co https://api.open-meteo.com; frame-src http: https:</tizen:content-security-policy>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
